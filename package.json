{
  "name": "l2beat",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.0.0"
  },
  "packageManager": "pnpm@9.12.3+sha512.cce0f9de9c5a7c95bef944169cc5dfe8741abfb145078c0d508b868056848a87c81e626246cb60967cbd7fd29a6c062ef73ff840d96b3c86c40ac92cf4a813ee",
  "pnpm": {
    "overrides": {
      "form-data@^2": "2.5.4",
      "form-data@^4": "4.0.4",
      "js-yaml": "^4.3.1",
      "nanoid": "^3.3.17",
      "brace-expansion": "^2.1.4",
      "ip-address": "^10.3.1",
      "next": "^15.5.21",
      "postcss": "^8.5.18",
      "react-router": "^7.18.0",
      "sharp": "^0.35.0",
      "linkify-it": "^5.0.2",
      "tar": "^7.5.19",
      "vite": "^6.4.3",
      "undici": "^6.27.0",
      "ws": "^8.21.0",
      "form-data": "^4.0.6",
      "turbo-stream": "^3.0.0",
      "tmp": "^0.2.6",
      "kysely": "^0.28.17",
      "lodash": "^4.18.0",
      "path-to-regexp": "^8.4.0",
      "picomatch": "^4.0.4",
      "serialize-javascript": "^7.0.3",
      "minimatch": "^9.0.7",
      "koa": "^2.16.4",
      "rollup": "^4.59.0",
      "@remix-run/router": "^1.23.2",
      "glob": "^10.5.0",
      "tar-fs": "^2.1.4",
      "image-size": "npm:image-size-next@^2.1.0",
      "elliptic": "^6.6.1",
      "cross-spawn": "^7.0.5"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "build:backend": "turbo run build --filter=@l2beat/backend",
    "build:frontend": "turbo run build --filter=@l2beat/frontend",
    "build:frontend-ci": "turbo run build --cache local:rw,remote:r --summarize --filter=@l2beat/frontend",
    "build:tools-api": "turbo run build --filter=@l2beat/tools-api",
    "build:public": "turbo run build --filter=@l2beat/backend-tools --filter=@l2beat/discovery --filter=@l2beat/uif",
    "build:public-api": "turbo run build --filter=@l2beat/public-api",
    "build:protocolbeat": "turbo run build --filter=@l2beat/protocolbeat",
    "build:tools": "turbo run build --filter=@l2beat/tools",
    "build:token-backend": "turbo run build --filter=@l2beat/token-backend",
    "build:uops-dashboard": "turbo run build --filter=@l2beat/uops-dashboard",
    "build:dependencies": "turbo run build --filter=@l2beat/frontend^... --filter=@l2beat/backend^... --filter=@l2beat/tools-api --filter=@l2beat/l2b",
    "build:dependencies:frontend": "turbo run build --filter=@l2beat/frontend^...",
    "build:dependencies:backend": "turbo run build --filter=@l2beat/backend^...",
    "build:dependencies:dal": "turbo run build --filter=@l2beat/dal^...",
    "build:dependencies:l2b": "turbo run build --filter=@l2beat/l2b^...",
    "build:dependencies:discovery": "turbo run build --filter=@l2beat/discovery^...",
    "build:dependencies:config": "turbo run build --filter=@l2beat/config^...",
    "build:dependencies:public-api": "turbo run build --filter=@l2beat/public-api^...",
    "build:dependencies:token-backend": "turbo run build --filter=@l2beat/token-backend^...",
    "build:dependencies:token-ui": "turbo run build --filter=@l2beat/token-ui^...",
    "watch:dependencies": "turbo watch build --filter=@l2beat/frontend^... --filter=@l2beat/backend^... --filter=@l2beat/tools-api --filter=@l2beat/l2b",
    "watch:dependencies:frontend": "turbo watch build --filter=@l2beat/frontend^... --ui tui",
    "watch:dependencies:backend": "turbo watch build --filter=@l2beat/backend^... --ui tui",
    "watch:dependencies:dal": "turbo watch build --filter=@l2beat/dal^... --ui tui",
    "watch:dependencies:l2b": "turbo watch build --filter=@l2beat/l2b^... --ui tui",
    "watch:dependencies:discovery": "turbo watch build --filter=@l2beat/discovery^... --ui tui",
    "watch:dependencies:config": "turbo watch build --filter=@l2beat/config^... --ui tui",
    "watch:dependencies:public-api": "turbo watch build --filter=@l2beat/public-api^... --ui tui",
    "watch:dependencies:token-backend": "turbo watch build --filter=@l2beat/token-backend^... --ui tui",
    "clean": "turbo run clean",
    "fix": "pnpm lint:fix && pnpm format:fix",
    "format": "pnpm -r format",
    "format:fix": "pnpm -r format:fix",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "start": "cd packages/backend && pnpm start",
    "test": "turbo run test -- --reporter progress",
    "test:exclude-backend": "turbo run test --filter=!@l2beat/backend --filter=!@l2beat/database",
    "typecheck": "turbo run typecheck",
    "ci:check": "turbo run ci:check",
    "heroku-postbuild": "pnpm build:backend && pnpm install --production",
    "checkout": "pnpm clean && pnpm && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@changesets/cli": "^2.26.2",
    "@sinonjs/fake-timers": "^10.0.2",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.16",
    "@types/sinonjs__fake-timers": "^8.1.2",
    "earl": "^1.1.0",
    "esbuild": "^0.25.1",
    "esbuild-register": "^3.6.0",
    "mocha": "^10.2.0",
    "ts-node": "^10.9.1",
    "turbo": "^2.5.6",
    "typescript": "^5.5.3",
    "wait-for-expect": "^3.0.2"
  }
}
